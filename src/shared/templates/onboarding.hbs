<div style="font-family:Arial,sans-serif;background:#f5f7fb;padding:40px 20px;">
  <div
    style="max-width:500px;margin:auto;background:#fff;padding:30px;border-radius:10px;"
  >

    <h2 style="margin-top:0;color:#222;">
      Welcome to
      {{companyName}}
    </h2>

    <p>Hello {{userName}},</p>

    <p>
      Your account has been created successfully. You can use the following
      credentials to log in to the IEKA Workforce platform.
    </p>

    <div
      style="background:#f5f5f5;padding:20px;border-radius:8px;margin:20px 0;"
    >
      <p style="margin:0 0 10px;">
        <strong>User ID:</strong>
        {{userId}}
      </p>

      <p style="margin:0;">
        <strong>Password:</strong>
        {{password}}
      </p>
    </div>

    <div
      style="background:#eef5ff;padding:20px;border-radius:8px;margin:20px 0;"
    >
      <p style="margin:0 0 10px;">
        <strong>IEKA Workforce Platform</strong>
      </p>

      <p style="margin:0 0 15px;">
        Access your account here:
      </p>

      <a
        href="https://workforce.ieka.in"
        style="display:inline-block;background:#2563eb;color:#fff;text-decoration:none;padding:12px 20px;border-radius:6px;font-weight:bold;"
      >
        Open Workforce
      </a>

      <p style="font-size:13px;color:#666;margin:15px 0 0;">
        https://workforce.ieka.in
      </p>
    </div>

    <div style="border-top:1px solid #eee;padding-top:20px;margin-top:20px;">
      <h3 style="font-size:16px;color:#222;">
        Install IEKA Workforce as an App
      </h3>

      <p style="font-size:14px;color:#555;">
        IEKA Workforce is available as a App, so you can install it on your
        phone or computer without downloading it from an app store.
      </p>

      <p style="font-size:14px;color:#555;">
        <strong>On Android:</strong><br />
        Open
        <a href="https://workforce.ieka.in" style="color:#2563eb;">
          workforce.ieka.in
        </a>
        in Chrome, then select
        <strong>Install app</strong>
        or
        <strong>Add to Home screen</strong>.
      </p>

      <p style="font-size:14px;color:#555;">
        <strong>On iPhone/iPad:</strong><br />
        Open
        <a href="https://workforce.ieka.in" style="color:#2563eb;">
          workforce.ieka.in
        </a>
        in Safari, tap the
        <strong>Share</strong>
        button, then select
        <strong>Add to Home Screen</strong>.
      </p>

      <p style="font-size:14px;color:#555;">
        <strong>On Windows/Mac:</strong><br />
        Open the website in a supported browser and use the
        <strong>Install</strong>
        option in the browser's address bar or menu.
      </p>
    </div>

    <p>
      Regards,<br />
      {{companyName}}
      Team
    </p>

    <p style="font-size:12px;color:#999;margin-top:30px;">
      This email contains your account credentials. Please keep them secure and
      do not share your password with anyone.
    </p>

  </div>
</div>